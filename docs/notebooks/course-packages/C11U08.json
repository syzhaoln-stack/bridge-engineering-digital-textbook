    "setup": {
      "min": 0,
      "max": 0.98,
      "start": 0.1,
      "end": 0.9,
      "step": 0.01,
      "label": "两控制方向的接近程度 s",
      "unit": "",
      "output": "所需控制量绝对值",
      "outunit": "",
      "formula": "A=[[1,1],[1,2−s]]；A x=[0,1]ᵀ；|x|=1/(1−s)",
      "boundary": "二阶教学反算模型；s趋近1时矩阵奇异，数值精度不能补足独立信息。"
